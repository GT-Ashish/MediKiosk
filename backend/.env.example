# MediKiosk Backend Environment Configuration
# Copy this file to .env and fill in actual values.
# NEVER commit the .env file to version control.

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=MediKiosk
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS — allowed frontend origins (comma-separated) ────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Session ───────────────────────────────────────────────────────────────────
# How long an ACTIVE session is valid before it is auto-abandoned (minutes)
SESSION_TTL_MINUTES=60

# ── Documents ────────────────────────────────────────────────────────────────
# Maximum number of documents a patient can upload per session
MAX_DOCUMENTS_PER_SESSION=10

# ── AI Feature Flags ──────────────────────────────────────────────────────────
# Master switch for LLM-assisted features. Leave false until Phase 7+.
AI_ENABLED=false

# ── Logging ───────────────────────────────────────────────────────────────────
# Do NOT use DEBUG in production — may log request bodies containing patient data
LOG_LEVEL=INFO

# ── Database (not yet implemented — Phase 6+) ─────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/medikiosk

# ── AI Service Keys (not yet implemented — Phase 7+) ─────────────────────────
# GEMINI_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here
# Store all secrets in environment variables — NEVER in source code.
